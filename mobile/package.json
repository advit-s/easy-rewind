{
  "name": "@easy-rewind/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "start": "expo start --android",
    "android": "expo start --android",
    "android:development": "expo start --android --dev-client",
    "android:export": "expo export --platform android --output-dir .expo-release-export",
    "test:import-safety": "node --test test/import-safety.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "expo": "~57.0.0",
    "expo-background-task": "~57.0.6",
    "expo-constants": "~57.0.0",
    "expo-crypto": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.7",
    "expo-router": "~57.0.7",
    "expo-secure-store": "~57.0.1",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.6",
    "react": "19.2.8",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.8",
    "babel-preset-expo": "~57.0.0",
    "typescript": "~6.0.3"
  }
}
