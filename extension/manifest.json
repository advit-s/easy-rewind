{
  "manifest_version": 3,
  "name": "easy-rewind — Knowledge Assistant",
  "version": "2.0.0",
  "description": "Instant AI definitions, smart bookmarks, quick notes, research later, and reminders — all without leaving your page.",

  "action": {
    "default_popup": "popup.html",
    "default_title": "easy-rewind (Ctrl+Shift+E)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-loader.js"],
      "run_at": "document_idle"
    }
  ],

  "permissions": ["activeTab", "alarms", "contextMenus", "notifications", "storage"],

  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],

  "web_accessible_resources": [
    {
      "resources": ["content.js", "src/message-contracts.js", "src/privacy-policy.js"],
      "matches": ["http://*/*", "https://*/*"],
      "use_dynamic_url": true
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'"
  },

  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Open easy-rewind popup"
    }
  }
}
