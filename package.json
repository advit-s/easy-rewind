{
  "name": "easy-rewind",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first learning assistant for Chrome and Windows",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.6.2 <12"
  },
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "backend",
    "desktop",
    "packages/contracts",
    "mobile"
  ],
  "scripts": {
    "install:clean": "npm ci",
    "start": "npm run start --workspace=easy-rewind-backend",
    "dev": "npm run dev --workspace=easy-rewind-backend",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write package.json .github backend/package.json desktop/package.json packages/contracts mobile scripts docs README.md SECURITY.md",
    "format:check": "prettier --check package.json .github backend/package.json desktop/package.json packages/contracts mobile scripts docs README.md SECURITY.md",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "npm run test:workspace && npm run test:containment && npm run test:hygiene",
    "test:integration": "npm run test:backend && npm run test:backend:legacy-safe",
    "test:workspace": "node --test scripts/build/rebuild-electron-native.test.mjs scripts/validation/backend-independence.test.mjs scripts/validation/stage1-ci-security.test.mjs scripts/validation/workspace-contract.test.mjs scripts/testing/run-legacy-backend-tests.test.mjs scripts/validation/validate-extension.test.mjs",
    "test:containment": "node --test scripts/legacy/*.test.mjs",
    "test:hygiene": "node --test scripts/hygiene/check-repository.test.mjs",
    "test:requirements": "node --test scripts/validation/stage2-requirements.test.mjs",
    "test:backend": "npm --workspace backend test",
    "test:migrations": "node --test backend/src/database/*.test.js backend/src/legacy/*.test.js",
    "test:lifecycle": "node --test backend/src/lifecycle/*.test.js backend/test/import-safety.test.js",
    "test:backend:legacy-safe": "node scripts/testing/run-legacy-backend-tests.mjs",
    "test:contracts": "npm --workspace @easy-rewind/contracts test && node --test backend/src/http/contract-routes.test.js backend/src/http/compatibility-routes.test.js",
    "test:domain": "node --test backend/src/domain/**/*.test.js backend/src/ai/*.test.js backend/src/routes/content-routes.test.js backend/src/routes/learning-routes.test.js backend/src/routes/reminder-routes.test.js backend/src/routes/research-routes.test.js",
    "test:jobs": "node --test backend/src/jobs/*.test.js backend/src/scheduler/*.test.js",
    "test:remote": "node --test backend/src/remote/*.test.js",
    "test:sync": "node --test backend/src/sync/*.test.js backend/src/lan/*.test.js backend/src/routes/sync-routes.test.js",
    "test:import-export": "node --test backend/src/import-export/*.test.js backend/src/routes/import-export-routes.test.js",
    "test:extension": "node --test extension/test/*.test.js scripts/validation/extension-package.test.mjs",
    "test:dashboard": "node --test frontend/test/*.test.mjs backend/src/http/dashboard-routes.test.js",
    "test:desktop-package": "node --test scripts/validation/validate-desktop-package.test.mjs",
    "test:release-artifacts": "node --test scripts/validation/validate-release-artifacts.test.mjs",
    "test:android-release": "node --test scripts/validation/validate-android-release.test.mjs",
    "test:mobile": "node --test mobile/test/*.test.mjs",
    "test:mobile:import-safety": "node --test mobile/test/import-safety.test.mjs",
    "mobile:android": "npm run android --workspace=@easy-rewind/mobile",
    "mobile:android:export": "npm run android:export --workspace=@easy-rewind/mobile",
    "mobile:typecheck": "npm run typecheck --workspace=@easy-rewind/mobile",
    "validate:extension": "node scripts/validation/validate-extension.mjs --package",
    "validate:dashboard": "node scripts/validation/validate-dashboard.mjs",
    "validate:desktop-package": "node scripts/validation/validate-desktop-package.mjs",
    "validate:release-artifacts": "node scripts/validation/validate-release-artifacts.mjs --write-checksums",
    "validate:android-release": "node scripts/validation/validate-android-release.mjs",
    "validate:mobile": "node scripts/validation/validate-mobile.mjs",
    "scan:secrets": "secretlint \"**/*\"",
    "check:hygiene": "node scripts/hygiene/check-repository.mjs",
    "build": "npm run validate:extension && node --check backend/server.js && node --check desktop/main.js",
    "install:electron": "npm --workspace desktop run install:electron",
    "rebuild:native": "npm run install:electron && npm --workspace desktop run rebuild:native",
    "verify:native": "npm --workspace desktop run verify:native",
    "validate:native": "npm --workspace desktop run validate:native",
    "audit:production": "npm audit --omit=dev",
    "verify": "npm run verify:stage1 && npm run verify:stage2",
    "verify:stage1": "npm run scan:secrets && npm run check:hygiene && npm run lint && npm run format:check && npm test && npm run build",
    "verify:stage2": "npm run test:requirements && npm --workspace backend test && npm run test:contracts && npm run test:migrations && npm run test:lifecycle && npm run verify:native && npm run audit:production && npm run scan:secrets && npm run check:hygiene",
    "verify:stage3": "npm run test:domain && npm run test:jobs && npm run test:remote && npm run test:import-export && npm run test:sync && npm --workspace backend test && npm run test:contracts && npm run scan:secrets && npm run check:hygiene",
    "desktop:dev": "npm run dev --workspace=easy-rewind-desktop",
    "desktop:build": "npm run build --workspace=easy-rewind-desktop",
    "package:windows": "npm run desktop:build"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "13.0.4",
    "js-yaml": "4.3.0",
    "prettier": "3.9.6",
    "secretlint": "13.0.4"
  }
}
